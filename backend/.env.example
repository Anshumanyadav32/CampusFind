# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/CampusFind

# JWT Secret - must be at least 32 characters long
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long

# Server Port
PORT=5000

# Authentication Mode: 'local' (development only) or 'oidc' (production campus SSO)
AUTH_MODE=local
# Optional auth endpoint rate-limit overrides. Defaults: 100 attempts per 15 minutes locally, 10 otherwise.
AUTH_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=

# CORS Allowed Origins (comma-separated for multiple origins)
CLIENT_ORIGINS=http://localhost:5173

# Frontend Redirection URL after Campus SSO
FRONTEND_URL=http://localhost:5173

# Campus OIDC Single Sign-On Configuration (Required when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/auth/callback
OIDC_STUDENT_ID_CLAIM=student_id

# Cloudinary Image Storage Configuration (Optional - falls back to local /uploads directory if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Notification & Handover OTP Configuration
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
#    - Select app: "Mail", device: "CampusFind Server" (or Custom name)
#    - Google will provide a 16-character app password (e.g., abcd efgh ijkl mnop)
# 3. Enter the 16-character password below without spaces as SMTP_PASS.
# Note: Never use your regular Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-campus-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="CampusFind" <your-campus-email@gmail.com>
HANDOVER_OTP_EXPIRY_MINUTES=10

# College student verification (optional). Leave disabled for local development.
REQUIRE_COLLEGE_EMAIL_VERIFICATION=false
ALLOWED_EMAIL_DOMAINS=
EMAIL_OTP_EXPIRY_MINUTES=10

# Initial Administrator Seed Credentials (Required only when running backend/scripts/seedAdmin.js)
ADMIN_EMAIL=
ADMIN_STUDENT_ID=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
